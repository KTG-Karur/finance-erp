# Template only — copy the values you need into .env.development / .env.test /
# .env.production (all three are gitignored, this file is the one that's committed).
# Which mode actually runs is chosen by NODE_ENV in the plain `.env` file, not here.

PORT=5050
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
MASTER_DB_NAME=finance_master_db

JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of origins the API will accept browser requests from.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
