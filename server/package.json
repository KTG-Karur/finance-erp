{
  "name": "financial-erp-server",
  "version": "1.0.0",
  "description": "Multi-Tenant Financial ERP Backend API with Fastify and MySQL",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "migrate:master": "node scripts/migrate.js master",
    "migrate:tenant": "node scripts/migrate.js tenant",
    "finance:audit": "node ../finance-regression/cli.js",
    "finance:audit:ci": "node ../finance-regression/cli.js --ci",
    "finance:audit:quick": "node ../finance-regression/cli.js --quick",
    "finance:reconcile": "node ../finance-regression/reconcile-cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@fastify/static": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.2"
  }
}
